    {
      "type": "java",
      "request": "launch",
      "name": "Neoforge - Client",
      "presentation": {
        "group": "NG - neoforge",
        "order": 0
      },
      "projectName": "neoforge",
      "mainClass": "net.neoforged.fml.startup.Client",
      "args": [
        "--version",
        "26.1.0.19-beta",
        "--assetIndex",
        "asset-index",
        "--assetsDir",
        "/home/yuan/.gradle/caches/minecraft/assets"
      ],
      "vmArgs": [
        "--sun-misc-unsafe-memory-access\u003dallow",
        "--enable-native-access\u003dALL-UNNAMED",
        "--add-opens",
        "java.base/java.lang.invoke\u003dALL-UNNAMED",
        "--add-exports",
        "jdk.naming.dns/com.sun.jndi.dns\u003djava.naming",
        "-Dforge.logging.markers\u003dSCAN,REGISTRIES",
        "-Dforge.logging.console.level\u003ddebug",
        "-Dforge.enabledGameTestNamespaces\u003dwsmc",
        "-Dmixin.debug.verbose\u003dtrue",
        "-Dmixin.debug.export\u003dfalse",
        "-Dneoforge.enableGameTest\u003dtrue",
        "-Djava.net.preferIPv6Addresses\u003dsystem"
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {
        "MOD_CLASSES": "neoforge%%/home/yuan/Documents/Git/Minecraft/wsmc/neoforge/bin/main"
      },
      "shortenCommandLine": "argfile"
